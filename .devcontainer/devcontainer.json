// Окружение практики №7: PHP 8.4 + MySQL 8.4 + phpMyAdmin.
// Скопируйте папку .devcontainer в корень своего репозитория и откройте Codespace.
{
  "name": "PHP + MySQL (Web-программирование)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // 8080 — сайт (php -S 0.0.0.0:8080), 8081 — phpMyAdmin.
  // Порты не пробрасываются заранее: проброс, созданный до запуска сервера, отвечал 502.
  // 8080 Codespaces находит сам после запуска php -S; если нет — Ports → Add Port → 8080.
  // 8081 (phpMyAdmin в соседнем контейнере) добавляется вручную: Ports → Add Port → 8081.
  "portsAttributes": {
    "8080": { "label": "Сайт (php -S)", "onAutoForward": "notify" },
    "8081": { "label": "phpMyAdmin", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client"]
    }
  }
}
